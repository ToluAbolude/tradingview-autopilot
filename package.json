{
  "name": "tradingview-mcp",
  "version": "1.0.0",
  "description": "MCP bridge for TradingView Desktop via Chrome DevTools Protocol",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "tv": "src/cli/index.js"
  },
  "exports": {
    ".": "./src/server.js",
    "./core": "./src/core/index.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "tv": "node src/cli/index.js",
    "test": "node tests/run-tests.mjs",
    "test:e2e": "node --test tests/e2e.test.js",
    "test:external": "node tests/run-tests.mjs --external",
    "test:unit": "node tests/run-tests.mjs",
    "test:cli": "node --test tests/cli.test.js",
    "test:all": "node tests/run-tests.mjs",
    "test:verbose": "node tests/run-tests.mjs --test-reporter=spec",
    "test:count": "node tests/run-tests.mjs --test-reporter=spec"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "chrome-remote-interface": "^0.33.2",
    "nodemailer": "^9.0.1",
    "protobufjs": "^8.6.5"
  }
}
